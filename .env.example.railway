# Variables to set on the Railway web service (Settings > Variables).
APP_NAME="Manabi LMS"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
APP_KEY_SEED=${{MySQL.MYSQLPASSWORD}}   # or set APP_KEY directly (php artisan key:generate --show)
LOG_CHANNEL=stderr

DB_CONNECTION=mysql
DB_URL=${{MySQL.MYSQL_URL}}

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
